# Test environment variables (inside Docker)
APP_ENV=testing
APP_SECRET_KEY=test_secret_key_for_testing_only_32ch
DEBUG=true

# Database (Docker service names)
DATABASE_URL=postgresql+asyncpg://brujula:brujula123@db-test:5432/brujula_test_db
DATABASE_URL_SYNC=postgresql://brujula:brujula123@db-test:5432/brujula_test_db

# Redis (Docker service name)
REDIS_URL=redis://redis-test:6379/0

# JWT
JWT_SECRET_KEY=test_jwt_secret_key_for_testing_only_
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption
ENCRYPTION_KEY=test_encryption_key_for_testing_32c

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/tmp/uploads

# Plan limits
FREE_PLAN_MAX_UPLOADS=5
FREE_PLAN_MAX_AI_CALLS_PER_DAY=10
FREE_PLAN_MAX_ALERT_RULES=3
MAX_UPLOAD_SIZE_MB=10

# cTrader
CTRADER_HOST_LIVE=live.ctraderapi.com
CTRADER_HOST_DEMO=demo.ctraderapi.com
CTRADER_PORT=5035

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
