# ──────────────────────────────────────────────
# La Brújula del Trader — Production Environment
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values

# ─── App ───────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_SECRET_KEY=change_this_to_random_32_chars
JWT_SECRET_KEY=change_this_to_random_32_chars
ENCRYPTION_KEY=change_this_to_random_32_hex

# ─── Database ──────────────────────────────────
POSTGRES_DB=brujula_db
POSTGRES_USER=brujula
POSTGRES_PASSWORD=change_this_strong_password
DATABASE_URL=postgresql+asyncpg://brujula:change_this_strong_password@db:5432/brujula_db
DATABASE_URL_SYNC=postgresql://brujula:change_this_strong_password@db:5432/brujula_db

# ─── Redis ─────────────────────────────────────
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:change_this_redis_password@redis:6379/0

# ─── CORS ──────────────────────────────────────
CORS_ORIGINS=https://brujula.app,https://www.brujula.app

# ─── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.brujula.app
NEXT_PUBLIC_APP_NAME=La Brújula del Trader
NEXT_PUBLIC_DEFAULT_LOCALE=es

# ─── cTrader ───────────────────────────────────
CTRADER_HOST_LIVE=live.ctraderapi.com
CTRADER_HOST_DEMO=demo.ctraderapi.com
CTRADER_PORT=5035

# ─── AI (optional) ────────────────────────────
ANTHROPIC_API_KEY=

# ─── Storage ───────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/uploads

# ─── Plan Limits ───────────────────────────────
FREE_PLAN_MAX_UPLOADS=5
FREE_PLAN_MAX_AI_CALLS_PER_DAY=10
FREE_PLAN_MAX_ALERT_RULES=3
MAX_UPLOAD_SIZE_MB=10
